{
  "name": "just-another-highlighter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: persistent text-anchored highlights and a lightweight knowledge manager.",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "dev": "node build.mjs --watch",
    "package": "bash scripts/package.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node build.mjs --dev && playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
