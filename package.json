{
  "name": "just-another-highlighter",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Chrome and Firefox extension: persistent text-anchored highlights and a lightweight knowledge manager.",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "build:firefox": "node build.mjs --browser=firefox",
    "build-for-amo": "node build.mjs --browser=firefox",
    "dev": "node build.mjs --watch",
    "dev:firefox": "node build.mjs --watch --browser=firefox",
    "lint:firefox": "npx --yes web-ext@10.7.0 lint --source-dir dist-firefox",
    "package": "bash scripts/package.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node build.mjs --dev && playwright test",
    "test:e2e:firefox": "node build.mjs --dev --browser=firefox && playwright test -c playwright.firefox.config.ts",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:firefox && npm run lint:firefox"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
